                <AuxValue name="JavaCodeGenerator_AddingCodePost" type="java.lang.String" value="javax.swing.text.MaskFormatter mascaraFecha = null;&#xa;try {&#xa;    mascaraFecha = new javax.swing.text.MaskFormatter(&quot;##/##/####&quot;);&#xa;    mascaraFecha.setPlaceholderCharacter(&apos;_&apos;);&#xa;} catch (java.text.ParseException e) {&#xa;    e.printStackTrace();&#xa;}&#xa;// Asignas la m&#xe1;scara al campo formateado&#xa;JFormattedTextField jFormattedTextField1 = new JFormattedTextField(mascaraFecha);"/>
